# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. .env.development and .env.production are committed on purpose:
# they hold no secrets, only which database each environment talks to. Secrets
# and personal overrides belong in the *.local variants, which stay ignored.
.env*
!.env.example
!.env.development
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# databases and their backups — never committed, never in a diff
/data/*
!/data/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm
