# Production. The real cards and review history live here. Nothing that runs
# under `next dev` or `drizzle-kit push` is allowed to touch this file — see
# the guards in drizzle.config.ts and src/lib/db/config.ts.
DATABASE_URL=file:./data/prod.db

# When production moves off this machine, put the Turso credentials in
# .env.production.local (gitignored) — it takes precedence over this file:
# DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=

# Off-machine copy of every snapshot. Point this at a synced folder — iCloud
# Drive, Dropbox, an external disk — and backups survive losing this machine.
# Left unset, backups stay in data/backups/ only.
# BACKUP_MIRROR_DIR=~/Library/Mobile Documents/com~apple~CloudDocs/fcards-backups
