# Both environments are configured by the committed .env.development and
# .env.production files, so there is nothing you must create to run the app.
#
# This file lists the variables those set, and what you would override in a
# .env.development.local / .env.production.local (gitignored) of your own.
#
# Never set DATABASE_URL in .env.local — that file is loaded in *both*
# environments and would point development at the production database.

# libSQL/SQLite connection string. A `file:` URL is a local SQLite file.
DATABASE_URL=file:./data/dev.db

# Only needed for a remote Turso database.
# TURSO_AUTH_TOKEN=

# Production only: where to mirror backups so they leave this machine.
# BACKUP_MIRROR_DIR=~/Dropbox/fcards-backups
