# Development needs nothing beyond the committed .env.development (a local
# SQLite file) plus the auth variables below, in .env.development.local.
#
# Production's values live in Vercel's project settings, and — for running
# `pnpm db:migrate:prod` from your machine — in .env.production.local.
# Never put DATABASE_URL in .env.local: it is loaded in *both* environments.

# libSQL connection string. `file:` is a local SQLite file; production is
# libsql://<db>-<org>.turso.io
DATABASE_URL=file:./data/dev.db
# Only for the remote Turso database.
# TURSO_AUTH_TOKEN=

# Better Auth. Generate the secret with `openssl rand -base64 32`; the URL is
# where the app is served (http://localhost:3000 in development).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# A GitHub OAuth app per environment: github.com/settings/developers. Its
# callback URL is <BETTER_AUTH_URL>/api/auth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional link enrichment. Server-only; leave blank to save links without it.
TAVILY_API_KEY=
GROQ_API_KEY=
